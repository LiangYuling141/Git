# =============================================================================
# LyMtrix-TEF 配置模板
# =============================================================================
# 初始化：cp .env.example .env，再填入真实值。
# .env 是本地唯一配置入口，已被 .gitignore 忽略，禁止提交。
# 本模板随仓库跟踪，只放占位符与默认值，不得写入真实密钥。
#
# 新增配置项时：先改本文件，再同步 docs/00-framework.md §9.5 与 README“本地运行”。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 数据库（必填）
# -----------------------------------------------------------------------------
# PostgreSQL 连接串。Prisma CLI 侧由 prisma.config.ts 读取；
# 运行时由 src/lib/prisma.ts 的 PrismaPg driver adapter 读取。
DATABASE_URL="postgresql://user:password@localhost:5432/lymtrix?schema=public"

# -----------------------------------------------------------------------------
# 2. 可信执行（必填）
# -----------------------------------------------------------------------------
# TEF 确认令牌的 HMAC-SHA256 签名密钥，至少 32 字符。
# 缺失或过短时服务会拒绝签发令牌，而不是降级成弱密钥。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TEF_TOKEN_SECRET=""

# -----------------------------------------------------------------------------
# 3. Redis（可选）
# -----------------------------------------------------------------------------
# 未配置或连接失败时限流 fail-open（放行一切），仅适合本地开发。
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 4. 模型接入（可选）
# -----------------------------------------------------------------------------
# 留空或保留占位符时，意图解析回落到确定性规则解析器，闭环仍可完整跑通。
# Key 需至少 20 字符，且不能以 your / xxx / placeholder / changeme 开头。
# 任何 OpenAI 兼容服务都可以接入，改 API_BASE 与 MODEL 即可。
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# -----------------------------------------------------------------------------
# 5. 日志（可选）
# -----------------------------------------------------------------------------
# 未设置时默认 ./logs；仅 production 环境写文件，开发环境输出到控制台。
# LOG_DIR="./logs"

# -----------------------------------------------------------------------------
# 6. RLS 隔离验证（可选，仅 npm run rls:* 使用）
# -----------------------------------------------------------------------------
# 非超级用户应用角色。prepare-app-role 创建它，app-role-url 用它拼接连接串。
# 未设置时脚本使用以下默认值。
APP_DB_ROLE="lymtrix_app"
APP_DB_PASSWORD="lymtrix_app_ci_password"

# -----------------------------------------------------------------------------
# 7. 测试与运行时开关（可选）
# -----------------------------------------------------------------------------
# 设为 1 时 npm test 会额外执行 tests/integration（需要真实 PostgreSQL）。
# TEF_DB_TESTS=1

# 设为 1 时测试会保留 DEEPSEEK_API_KEY 并调用真实模型。
# 默认关闭，测试回落到确定性解析器，不依赖外部服务。
# TEF_MODEL_TESTS=1

# Next.js 监听端口，默认 3000。
# PORT=3000

# Next.js 遥测，CI 中设为 1；本地一般无需设置。
# NEXT_TELEMETRY_DISABLED=1
