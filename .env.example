# 复制成 .env.local 并填入真实值。
#
# 注意：本仓库的 .env 已经被 git 跟踪（早于 .gitignore 规则加入），
# 所以真实密钥不要写进 .env，写进 .env.local —— 它被 .gitignore 第 45 行覆盖。
# 独立脚本与 prisma.config.ts 都按 ['.env.local', '.env'] 的顺序加载，前者优先。

# PostgreSQL 连接串。Prisma 7 不再允许在 schema.prisma 的 datasource 里写 url，
# CLI 侧由 prisma.config.ts 读取，运行时由 src/lib/prisma.ts 的 PrismaPg adapter 读取。
DATABASE_URL="postgresql://user:password@localhost:5432/lymtrix?schema=public"

# TEF 确认令牌的 HMAC-SHA256 签名密钥（docs/technical/14-unified-architecture.md §4.3）。
# 必填，且至少 32 字符。缺失或过短时服务会拒绝签发令牌而不是降级成弱密钥。
# 生成： node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TEF_TOKEN_SECRET=""

# Redis。未配置时限流会 fail-open（放行一切），只适合本地开发。
REDIS_URL="redis://localhost:6379"

# 模型。留空或保留占位符时，意图解析会回落到确定性规则解析器 ——
# 闭环仍然可跑通，但"更换模型"这一项演示无法进行。
MINIMAX_API_KEY="your_api_key_here"
MINIMAX_API_BASE="https://api.minimax.chat/v1"
MINIMAX_GROUP_ID="your_group_id_here"

# 日志文件输出目录（可选）。
# LOG_DIR="./logs"
